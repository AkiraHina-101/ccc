=LET(nbCount,ROWS(rawNBLoad),obCount,ROWS(rawOBLoad),itemNo,SEQUENCE(nbCount+obCount),allLoads,IF(itemNo<=nbCount,INDEX(rawNBLoad,itemNo),INDEX(rawOBLoad,itemNo-nbCount)),SORT(UNIQUE(FILTER(allLoads,allLoads<>""))))
=LET(nbCount,ROWS(rawNBLoad),obCount,ROWS(rawOBLoad),itemNo,SEQUENCE(nbCount+obCount),allLoads,IF(itemNo<=nbCount,INDEX(rawNBLoad,itemNo),INDEX(rawOBLoad,itemNo-nbCount)),allRpms,IF(itemNo<=nbCount,INDEX(rawNBRPM,itemNo),INDEX(rawOBRPM,itemNo-nbCount)),SORT(UNIQUE(FILTER(allRpms,(allLoads=SPL!$D$2)*(allRpms<>""),""))))
